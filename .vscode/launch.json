{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Parse Classic talents",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scribe.py",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"args": [
				"--output", "ProviderClassic.lua",
				"${input:rawTalentFile}",
			]
		},
